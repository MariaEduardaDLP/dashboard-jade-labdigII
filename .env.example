# Copie este arquivo como .env e substitua os valores localmente.
# Nunca envie o .env nem o coloque no Git.
# Codifique caracteres reservados na senha; por exemplo, # vira %23.
JADE_DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_URL_ENCODED@HOST:PORT/postgres?sslmode=require
JADE_SERIAL_PORT=
JADE_SERIAL_BAUDRATE=115200
