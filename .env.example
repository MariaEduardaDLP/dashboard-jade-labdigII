# Copie os valores para as variáveis de ambiente do terminal.
# O Streamlit não carrega este arquivo automaticamente.
JADE_DATA_SOURCE=demo
# Usado apenas com JADE_DATA_SOURCE=api; deve incluir o prefixo da API, se houver.
JADE_API_URL=http://localhost:8000

# Backend: use JADE_DATABASE_URL com PostgreSQL. Exemplo local:
# JADE_DATABASE_URL=postgresql+psycopg://jade:senha@localhost:5432/jade
# Testes de backend: banco PostgreSQL separado, dedicado aos testes.
# JADE_TEST_DATABASE_URL=postgresql+psycopg://jade:senha@localhost:5432/jade_test
# Serial: habilite somente quando a prancha estiver conectada.
# JADE_SERIAL_ENABLED=true
# JADE_SERIAL_PORT=/dev/ttyUSB0
# JADE_SERIAL_BAUDRATE=115200  # Jade DE0-CV: 115200, 7E1
